# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# номер телефона твоего личного аккаунта, в международном формате: +79991234567
TG_PHONE=
# имя файла сессии (создастся сам после первого логина)
TG_SESSION=assistant_session

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# через запятую: chat_id пользователей/чатов, которым бот НЕ должен отвечать
IGNORE_CHAT_IDS=

# сколько последних сообщений диалога держать в контексте
HISTORY_LIMIT=20
